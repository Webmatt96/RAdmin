# ── RAdmin sensitive files ────────────────────────────────────────────────────
# The real config with credentials - NEVER commit this
radmin.conf

# TLS private key - NEVER commit this
*.key

# TLS certificate (contains no secrets but keep local)
*.crt

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
*.txt
!Notes.txt
!radmin.conf.example

# ── PyInstaller ───────────────────────────────────────────────────────────────
*.spec

# ── Environments ─────────────────────────────────────────────────────────────
.env
.venv
venv/
ENV/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
